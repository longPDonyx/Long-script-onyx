-- Equip Weapon
local function EquipWeapon(typeStr)
    local char = LocalPlayer.Character
    if not char then return end
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if (typeStr == "Melee" and item.ToolTip == "Melee") or
               (typeStr == "Sword" and item.ToolTip == "Sword") or
               (typeStr == "Fruit" and item.ToolTip == "Blox Fruit") then
                char.Humanoid:EquipTool(item)
            end
        end
    end
end

