                    if workspace.Map:FindFirstChild("Waterfall") and workspace.Map.Waterfall:FindFirstChild("Secretdoor") then
                        fireclickdetector(workspace.Map.Waterfall.Secretdoor.Yama.ClickDetector)
                    end
                else
                    local elite = workspace.Enemies:FindFirstChild("Deandre") or workspace.Enemies:FindFirstChild("Diablo") or workspace.Enemies:FindFirstChild("Urban")
                    if elite and elite:FindFirstChild("HumanoidRootPart") then
                        TweenTo(elite.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0))
                        FastAttack()
                    end
                end
            end

            if _G.AutoTushita then
                local longma = workspace.Enemies:FindFirstChild("Longma")
