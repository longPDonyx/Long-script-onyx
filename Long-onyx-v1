-- MAIN FARM LOOP
task.spawn(function()
    while task.wait(0.15) do
        pcall(function()
            if _G.AutoFarmLevel then
                EquipWeapon(_G.SelectWeapon)
                local qName, qNum, mName, mCFrame = GetQuestData()
                
                if not LocalPlayer.PlayerGui.Main.Quest.Visible then
                    TweenTo(mCFrame)
                    if (LocalPlayer.Character.HumanoidRootPart.Position - mCFrame.Position).Magnitude < 15 then
                        CommF:InvokeServer("StartQuest", qName, qNum)
                    end
                else
                    local mob = workspace.Enemies:FindFirstChild(mName)
                    if mob and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0 then
                        TweenTo(mob.HumanoidRootPart.CFrame * CFrame.new(0, 11, 0))
                        FastAttack()
                    else
                        TweenTo(mCFrame)
                    end
                end
            end

            if _G.AutoSoulReaper then
                local reaper = workspace.Enemies:FindFirstChild("Soul Reaper")
                if reaper and reaper:FindFirstChild("HumanoidRootPart") and reaper.Humanoid.Health > 0 then
                    TweenTo(reaper.HumanoidRootPart.CFrame * CFrame.new(0, 11, 0))
                    FastAttack()
                end
            end

            if _G.AutoFarmBone then
                local boneMob = workspace.Enemies:FindFirstChild("Reborn Skeleton") or workspace.Enemies:FindFirstChild("Living Zombie") or workspace.Enemies:FindFirstChild("Demonic Soul") or workspace.Enemies:FindFirstChild("Posessed Mummy")
                if boneMob and boneMob:FindFirstChild("HumanoidRootPart") and boneMob.Humanoid.Health > 0 then
                    TweenTo(boneMob.HumanoidRootPart.CFrame * CFrame.new(0, 11, 0))
                    FastAttack()
                else
                    TweenTo(CFrame.new(-9500, 170, 6000))
                end
            end

            if _G.AutoRandomBone then
                CommF:InvokeServer("Bones", "Buy", 1, 1)
                task.wait(1)
            end

            if _G.AutoCakePrince or _G.AutoDoughKing then
                local boss = workspace.Enemies:FindFirstChild("Cake Prince") or workspace.Enemies:FindFirstChild("Dough King")
                if boss and boss:FindFirstChild("HumanoidRootPart") and boss.Humanoid.Health > 0 then
                    TweenTo(boss.HumanoidRootPart.CFrame * CFrame.new(0, 12, 0))
                    FastAttack()
                else
