-- Safe Fast Attack (Bypass Anticheat)
local lastAttack = 0
local function FastAttack()
    if tick() - lastAttack >= 0.12 then
        lastAttack = tick()
        pcall(function()
            local Net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
            if Net and Net:FindFirstChild("RE/RegisterAttack") then
                Net["RE/RegisterAttack"]:FireServer()
            end
            VirtualUser:Button1Down(Vector2.new(500, 500))
            VirtualUser:Button1Up(Vector2.new(500, 500))
        end)
    end
end

-- Equip Weapon Engine
local function EquipWeapon(typeStr)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if (typeStr == "Melee" and item.ToolTip == "Melee") or
               (typeStr == "Sword" and item.ToolTip == "Sword") or
               (typeStr == "Fruit" and item.ToolTip == "Blox Fruit") then
                char.Humanoid:EquipTool(item)
            end
        end
    end
end

