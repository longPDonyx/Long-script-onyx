                    end
                end
            end

            if _G.AutoYama then
                local eliteKilled = CommF:InvokeServer("Elites", "Progress") or 0
                if tonumber(eliteKilled) >= 30 then
                    TweenTo(CFrame.new(-5256, 15, 9305))
