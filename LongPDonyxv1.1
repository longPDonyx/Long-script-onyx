-- Tween Controller
local currentTween = nil
local function StopTween()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        Platform.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, -3.5, 0)
    end
end

local function TweenTo(targetCFrame)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
        local hrp = char.HumanoidRootPart
        local dist = (hrp.Position - targetCFrame.Position).Magnitude
        
        Platform.CFrame = hrp.CFrame * CFrame.new(0, -3.5, 0)
        
        if dist < 12 then 
            hrp.CFrame = targetCFrame 
            StopTween()
            return 
        end
        
        local tweenInfo = TweenInfo.new(dist / _G.TweenSpeed, Enum.EasingStyle.Linear)
        if currentTween then currentTween:Cancel() end
        currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        currentTween:Play()
    end
end

-- NoClip & Water Walk
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
        if _G.WalkOnWater and char:FindFirstChild("HumanoidRootPart") then
            WaterPart.CanCollide = true
            WaterPart.CFrame = CFrame.new(char.HumanoidRootPart.Position.X, 0, char.HumanoidRootPart.Position.Z)
        else
            WaterPart.CanCollide = false
            WaterPart.CFrame = CFrame.new(0, -2000, 0)
        end
    end
end)

-- Fast Attack Engine
local lastAttack = 0
local function FastAttack()
    if tick() - lastAttack >= 0.12 then
        lastAttack = tick()
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then tool:Activate() end
                VirtualUser:Button1Down(Vector2.new(500, 500))
                task.wait(0.01)
                VirtualUser:Button1Up(Vector2.new(500, 500))
            end
        end)
    end
end

-- Bring Mob
local function BringMob(mobName, targetCFrame)
    pcall(function()
        for _, v in pairs(workspace.Enemies:GetChildren()) do
            if v.Name == mobName and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                local hrp = v.HumanoidRootPart
                if (hrp.Position - targetCFrame.Position).Magnitude <= 150 and (hrp.Position - targetCFrame.Position).Magnitude > 5 then
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.CFrame = targetCFrame * CFrame.new(0, 0, -2)
                    hrp.CanCollide = false
                    v.Humanoid.WalkSpeed = 0
                    v.Humanoid.JumpPower = 0
                end
            end
        end
    end)
end

-- Equip Weapon
local function EquipWeapon(typeStr)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Humanoid") then return end
    
    local heldTool = char:FindFirstChildOfClass("Tool")
    if heldTool then
        if (typeStr == "Melee" and heldTool.ToolTip == "Melee") or
           (typeStr == "Sword" and heldTool.ToolTip == "Sword") or
           (typeStr == "Fruit" and (heldTool.ToolTip == "Blox Fruit" or heldTool.ToolTip == "Demon Fruit")) then
            return
        end
    end

    for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
        if item:IsA("Tool") then
            if (typeStr == "Melee" and item.ToolTip == "Melee") or
               (typeStr == "Sword" and item.ToolTip == "Sword") or
               (typeStr == "Fruit" and (item.ToolTip == "Blox Fruit" or item.ToolTip == "Demon Fruit")) then
                char.Humanoid:EquipTool(item)
                break
            end
        end
    end
end

