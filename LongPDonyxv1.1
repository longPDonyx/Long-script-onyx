-- Background Main Farm Engine
local lastBoneBuy = 0
local lastQuestTake = 0

task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            local char = LocalPlayer.Character
            local CommF = GetCommF()
            if not char or not char:FindFirstChild("HumanoidRootPart") or char.Humanoid.Health <= 0 then return end

            -- 1. Auto Farm Level
            if _G.AutoFarmLevel and CommF then
                local qName, qNum, mName, npcCFrame, mobCFrame = GetQuestData()
                if qName then
                    local questUI = LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")
                    if not questUI or not questUI.Visible or not string.find(questUI.Container.QuestTitle.Title.Text, mName) then
                        TweenTo(npcCFrame)
                        if (char.HumanoidRootPart.Position - npcCFrame.Position).Magnitude < 15 and (tick() - lastQuestTake >= 1) then
                            lastQuestTake = tick()
                            CommF:InvokeServer("StartQuest", qName, qNum)
                        end
                    else
                        EquipWeapon(_G.SelectWeapon)
                        local mob = workspace.Enemies:FindFirstChild(mName)
                        if mob and mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            TweenTo(mob.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0))
                            BringMob(mName, mob.HumanoidRootPart.CFrame)
                            FastAttack()
                        else
                            TweenTo(mobCFrame)
                        end
                    end
                end
            end

            -- 2. Auto Teleport Island
            if _G.AutoTeleportIsland and _G.SelectIsland ~= "" then
                local currentMapIslands = Sea1Islands
                if game.PlaceId == 4442272183 then currentMapIslands = Sea2Islands
                elseif game.PlaceId == 7449423635 then currentMapIslands = Sea3Islands end
                
                local targetCFrame = currentMapIslands[_G.SelectIsland]
                if targetCFrame then
                    TweenTo(targetCFrame)
                end
            end

            -- 3. Auto Farm Bones
            if _G.AutoFarmBone then
                EquipWeapon(_G.SelectWeapon)
                local boneMob = nil
                for _, mob in pairs(workspace.Enemies:GetChildren()) do
                    if (mob.Name == "Reborn Skeleton" or mob.Name == "Living Zombie" or mob.Name == "Demonic Soul" or mob.Name == "Possessed Mummy") 
                    and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0 then
                        boneMob = mob
                        break
                    end
                end
                if boneMob then
                    TweenTo(boneMob.HumanoidRootPart.CFrame * CFrame.new(0, 10, 0))
                    BringMob(boneMob.Name, boneMob.HumanoidRootPart.CFrame)
                    FastAttack()
                else
                    TweenTo(CFrame.new(-9500, 170, 6000))
                end
            end

            if _G.AutoRandomBone and CommF and (tick() - lastBoneBuy >= 3) then
                lastBoneBuy = tick()
                CommF:InvokeServer("Bones", "Buy", 1, 1)
            end
        end)
    end
end)

